{
  "name": "pokerst8ts",
  "version": "1.0.0",
  "private": true,
  "description": "PokerSt8ts — a solo card/board game by Strategic Titans",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "package": "vite build && rm -f pokerst8ts-v1.0.0.zip && cd dist && zip -r ../pokerst8ts-v1.0.0.zip . && cd .. && echo 'Packaged: pokerst8ts-v1.0.0.zip'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "relay": "node server/relay.mjs",
    "relay:check": "node scripts/relay-check.mjs",
    "signup:check": "node scripts/signup-check.mjs",
    "auth:check": "node scripts/auth-check.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.61.1",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "nodemailer": "^9.1.1"
  }
}
